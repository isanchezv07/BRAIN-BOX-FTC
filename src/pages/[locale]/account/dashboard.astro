---
// @Isanchezv
// src/pages/[locale]/account/dashboard.astro
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { checkAndResetCredits } from "@/lib/credits";
import { getFilteredCourses, getCompletedCoursesIds, getLikedCourseIds, toggleCourseLike } from "@/lib/courses";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { user, profile } = Astro.locals;

if (!user) return Astro.redirect(`/${lang}/auth/signin`);

await checkAndResetCredits(user.id);

if (Astro.request.method === "POST") {
  try {
    const { courseId } = await Astro.request.json();
    const result = await toggleCourseLike(user.id, courseId);
    return new Response(JSON.stringify(result), { status: 200 });
  } catch (e: any) {
    return new Response(JSON.stringify({ error: e.message }), { status: 500 });
  }
}

const allCourses = await getFilteredCourses(profile?.role || 'student');
const likedCourseIds = await getLikedCourseIds(user.id);
const completedCoursesIds = await getCompletedCoursesIds(user.id, allCourses);

const activeCourses = allCourses.filter(c => {
    return !completedCoursesIds.has(c.id);
});

const completedCourses = allCourses.filter(c => completedCoursesIds.has(c.id));
const progress = allCourses.length > 0 ? Math.round((completedCoursesIds.size / allCourses.length) * 100) : 0;
---

<Layout title={t('nav.dashboard')}>
  <main class="relative bg-[#030303] text-white selection:bg-blue-600/50 font-sans antialiased min-h-screen overflow-hidden">
    
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_-20%,rgba(37,99,235,0.1),transparent_70%)]"></div>
        <div class="absolute inset-0 opacity-[0.02]" style="background-image: url('https://grainy-gradients.vercel.app/noise.svg');"></div>
    </div>

    <div class="max-w-7xl mx-auto p-6 md:p-12 space-y-12 relative z-10">
      
      <header class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-8 bg-white/[0.02] border border-white/5 p-8 md:p-10 rounded-[3rem] backdrop-blur-xl shadow-2xl">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-3 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 mb-2">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
            <span class="text-[8px] font-black text-blue-500 uppercase tracking-[0.3em] italic">System_User_Active</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-black text-white italic uppercase tracking-tighter leading-none">
            {t('dashboard.welcome')} <span class="text-transparent [-webkit-text-stroke:1px_white] opacity-80">{profile?.full_name || profile?.username || t('dashboard.defaultUser')}</span>
          </h1>
          <p class="text-zinc-500 text-[10px] font-mono uppercase tracking-[0.4em] italic">
            Access_Level: <span class="text-blue-500">{profile?.role || 'Guest'}</span> // ID: {user.id.slice(0,8)}
          </p>
        </div>

        <div class="flex flex-wrap gap-4">
            <div class="flex flex-col items-end px-6 py-4 rounded-2xl bg-black/40 border border-white/5 backdrop-blur-md">
                <span class="text-[9px] font-black text-zinc-600 uppercase tracking-widest mb-1 italic">AI_CREDITS_REMAINING</span>
                <span class="text-2xl font-black text-white italic tracking-tighter">{profile?.ai_credits || 0} <span class="text-xs text-blue-500">TOKENS</span></span>
            </div>
            <a href={`/${lang}/explore`} class="group relative px-8 py-4 bg-blue-600 text-black font-black uppercase italic text-xs tracking-[0.3em] overflow-hidden rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-[0_0_30px_rgba(37,99,235,0.3)] flex items-center gap-3">
                <span class="relative z-10 text-white group-hover:text-black transition-colors">ACCESS_ACADEMY</span>
                <svg class="relative z-10 text-white group-hover:text-black transition-colors" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                <div class="absolute inset-0 bg-white translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></div>
            </a>
        </div>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4 space-y-12">
          <section class="p-10 rounded-[3rem] bg-gradient-to-br from-white/[0.03] to-transparent border border-white/5 relative overflow-hidden group">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-blue-600/10 blur-[60px] group-hover:bg-blue-600/20 transition-all duration-1000"></div>
            
            <h3 class="text-[10px] font-black text-zinc-500 uppercase tracking-[0.4em] mb-8 italic flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                Global_Progress _
            </h3>
            
            <div class="relative flex items-center justify-center py-6">
                <svg class="w-48 h-48 transform -rotate-90">
                    <circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="12" fill="transparent" class="text-white/5" />
                    <circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="12" fill="transparent" 
                        stroke-dasharray={2 * Math.PI * 88} 
                        stroke-dashoffset={2 * Math.PI * 88 * (1 - progress / 100)} 
                        class="text-blue-600 transition-all duration-1000 ease-out"
                        stroke-linecap="round"
                    />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-5xl font-black text-white italic tracking-tighter">{progress}%</span>
                    <span class="text-[9px] font-black text-zinc-600 uppercase tracking-widest italic mt-1">Operational</span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 mt-8 pt-8 border-t border-white/5">
                <div class="space-y-1">
                    <span class="text-[9px] text-zinc-600 font-black uppercase italic">Completed</span>
                    <p class="text-xl font-black text-white italic">{completedCoursesIds.size}</p>
                </div>
                <div class="space-y-1 border-l border-white/5 pl-4">
                    <span class="text-[9px] text-zinc-600 font-black uppercase italic">Pending</span>
                    <p class="text-xl font-black text-zinc-400 italic">{activeCourses.length}</p>
                </div>
            </div>
          </section>

          <section class="space-y-4">
            <h3 class="text-[10px] font-black text-zinc-700 uppercase tracking-[0.4em] px-4 italic">Core_Utilities _</h3>
            <div class="grid grid-cols-1 gap-3">
                <a href={`/${lang}/account/perfil`} class="flex items-center justify-between p-6 rounded-2xl bg-white/[0.02] border border-white/5 hover:border-white/10 hover:bg-white/[0.04] transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 group-hover:scale-110 transition-transform">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <span class="text-xs font-black uppercase tracking-widest italic">Agent_Profile</span>
                    </div>
                    <svg class="text-zinc-700 group-hover:text-white transition-colors" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M9 18l6-6-6-6"/></svg>
                </a>
                <a href={`/${lang}/playground`} class="flex items-center justify-between p-6 rounded-2xl bg-white/[0.02] border border-white/5 hover:border-white/10 hover:bg-white/[0.04] transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-500 group-hover:scale-110 transition-transform">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M2 12h20"/><path d="m4.93 4.93 14.14 14.14M4.93 19.07 19.07 4.93"/></svg>
                        </div>
                        <span class="text-xs font-black uppercase tracking-widest italic">Code_Simulator</span>
                    </div>
                    <svg class="text-zinc-700 group-hover:text-white transition-colors" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M9 18l6-6-6-6"/></svg>
                </a>
            </div>
          </section>
        </div>

        <div class="lg:col-span-8 space-y-12">
          <section class="space-y-8">
            <div class="flex items-center justify-between px-4">
                <h3 class="text-[10px] font-black text-blue-500 uppercase tracking-[0.5em] italic flex items-center gap-3">
                    <span class="w-2 h-px bg-blue-500"></span>
                    Active_Deployment_Queue _
                </h3>
                <span class="text-[9px] font-mono text-zinc-700 uppercase" x-text={`'${activeCourses.length} Modules_Syncing'`}></span>
            </div>

            <div class="grid gap-6">
                {activeCourses.length > 0 ? activeCourses.slice(0, 3).map((course) => {
                    const isLiked = likedCourseIds.has(course.id);
                    return (
                        <div class="group relative bg-[#080808] border border-white/5 rounded-[2.5rem] overflow-hidden transition-all duration-500 hover:border-blue-500/30 hover:-translate-y-1">
                            <div class="absolute inset-0 bg-gradient-to-r from-blue-600/[0.02] to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            
                            <div class="flex flex-col md:flex-row items-stretch md:items-center p-8 gap-8 relative z-10">
                                <!-- Status Icon -->
                                <div class="w-20 h-20 rounded-2xl bg-white/[0.03] border border-white/5 flex items-center justify-center shrink-0 group-hover:bg-blue-600/10 group-hover:border-blue-500/20 transition-all duration-500">
                                    <svg class="text-blue-500 animate-pulse" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
                                </div>

                                <div class="flex-1 space-y-2">
                                    <div class="flex items-center gap-3 mb-1">
                                        <span class="text-[9px] font-black text-zinc-600 uppercase tracking-widest italic">{course.categories?.name || 'Technical'}</span>
                                        <div class="h-px w-8 bg-white/10"></div>
                                        <span class="text-[9px] font-black text-blue-500 uppercase tracking-widest italic">{course.level}</span>
                                    </div>
                                    <h4 class="text-2xl font-black text-white italic uppercase tracking-tighter group-hover:text-blue-400 transition-colors">{course.title}</h4>
                                    <p class="text-zinc-500 text-xs italic line-clamp-1 max-w-xl">{course.description}</p>
                                </div>

                                <div class="flex items-center gap-4">
                                    <button type="button" data-like-btn data-course-id={course.id} data-liked={isLiked ? "true" : "false"} class="p-4 rounded-xl bg-white/[0.03] border border-white/5 hover:border-pink-500/50 transition-all active:scale-90">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class={`transition-all duration-300 ${isLiked ? 'fill-pink-500 stroke-pink-500 scale-110' : 'fill-transparent stroke-zinc-600 hover:stroke-pink-400'}`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.505 4.046 3 5.5L12 21Z"/>
                                        </svg>
                                    </button>
                                    <a href={`/${lang}/courses/${course.id}`} class="px-8 py-4 bg-white text-black text-[10px] font-black uppercase italic rounded-xl hover:bg-blue-600 hover:text-white transition-all tracking-widest">
                                        RESUME_BOOT
                                    </a>
                                </div>
                            </div>
                        </div>
                    );
                }) : (
                    <div class="py-20 border-2 border-dashed border-white/5 rounded-[3rem] flex flex-col items-center justify-center text-center space-y-4">
                        <div class="text-zinc-800 uppercase font-black italic tracking-widest text-sm">No_Active_Modules_Detected</div>
                        <a href={`/${lang}/explore`} class="text-blue-500 text-[10px] font-black uppercase italic tracking-[0.3em] hover:text-white transition-colors underline decoration-blue-500/30">Browse_Academy_Database →</a>
                    </div>
                )}
            </div>
          </section>

          <section class="space-y-8">
            <h3 class="text-[10px] font-black text-zinc-700 uppercase tracking-[0.5em] px-4 italic flex items-center gap-3">
                <span class="w-2 h-px bg-zinc-700"></span>
                Archived_Certificates _
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {completedCourses.length > 0 ? completedCourses.map(course => (
                    <a href={`/${lang}/courses/${course.id}`} class="group p-8 bg-white/[0.01] border border-white/5 rounded-[2.5rem] hover:bg-green-500/[0.02] hover:border-green-500/20 transition-all flex items-center justify-between">
                        <div class="space-y-1">
                            <span class="text-[8px] font-black text-green-500 uppercase tracking-widest italic">Certified_Log</span>
                            <h5 class="text-lg font-black text-white italic uppercase tracking-tighter leading-none group-hover:text-green-400 transition-colors">{course.title}</h5>
                        </div>
                        <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-green-500 group-hover:border-green-500 group-hover:rotate-12 transition-all">
                            <svg class="text-zinc-600 group-hover:text-black" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                        </div>
                    </a>
                )) : (
                    <div class="md:col-span-2 py-12 text-center text-zinc-800 text-[10px] font-black uppercase italic tracking-widest border border-white/5 rounded-[2.5rem]">
                        Awaiting_First_Acreditation_Sequence...
                    </div>
                )}
            </div>
          </section>

        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  const likeButtons = document.querySelectorAll('[data-like-btn]');
  likeButtons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const courseId = btn.getAttribute('data-course-id');
      const isLiked = btn.getAttribute('data-liked') === 'true';
      const svg = btn.querySelector('svg');

      const updateUI = (state) => {
        btn.setAttribute('data-liked', String(state));
        if (state) {
          svg.classList.add('fill-pink-500', 'stroke-pink-500', 'scale-110');
          svg.classList.remove('fill-transparent', 'stroke-zinc-600');
        } else {
          svg.classList.remove('fill-pink-500', 'stroke-pink-500', 'scale-110');
          svg.classList.add('fill-transparent', 'stroke-zinc-600');
        }
      };

      updateUI(!isLiked);

      try {
        const response = await fetch(window.location.href, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ courseId }),
        });
        
        if (!response.ok) throw new Error();
        const data = await response.json();
        updateUI(data.liked);
      } catch (error) {
        console.error("Fallo en el Like:", error);
        updateUI(isLiked);
      }
    });
  });
</script>

<style>
  @keyframes pulse-soft {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  .animate-pulse {
    animation: pulse-soft 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>