---
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const { locale } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const info = [
  {
    title: t('membership.reset_title'),
    description: t('membership.reset_desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>`
  },
  {
    title: t('membership.cancellation_title'),
    description: t('membership.cancellation_desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>`
  },
  {
    title: t('membership.how_to_cancel_title'),
    description: t('membership.how_to_cancel_desc'),
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`
  }
];
---

<Layout title={t('membership.title') + " " + t('membership.highlight')} description={t('membership.subtitle')}>
  <main class="min-h-screen bg-[#050505] py-24 px-6 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-96 bg-blue-500/10 blur-[120px] pointer-events-none"></div>

    <a href={`/${lang}/shop/credits`} class="ml-80 inline-flex items-center gap-3 text-[10px] font-black text-gray-500 hover:text-white transition-all uppercase tracking-[0.2em] group">
      <div class="flex items-center justify-center w-8 h-8 rounded-full bg-white/5 border border-white/5 group-hover:border-blue-500/50 group-hover:bg-blue-500/10 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </div>
      {t('buttons.back')}
    </a>

    <div class="max-w-4xl mx-auto relative z-10">
      <header class="text-center mb-20">
        <h1 class="text-5xl md:text-6xl font-black italic text-white uppercase leading-tight mb-4">
          {t('membership.title')} <span class="text-blue-500">{t('membership.highlight')}</span>
        </h1>
        <p class="text-gray-500 font-bold uppercase tracking-[0.3em] text-sm">
          {t('membership.subtitle')}
        </p>
      </header>

      <div class="space-y-8">
        {info.map((item) => (
          <div class="bg-white/5 border border-white/10 rounded-[2rem] p-8 md:p-12 transition-all hover:bg-white/10 group">
            <div class="flex flex-col md:flex-row gap-8 items-start">
              <div class="bg-blue-600/20 p-4 rounded-2xl text-blue-500 flex-shrink-0 group-hover:bg-blue-600/30 transition-colors" set:html={item.icon}>
              </div>
              <div>
                <h2 class="text-2xl font-black italic text-white uppercase mb-4 tracking-wider">{item.title}</h2>
                <p class="text-gray-400 font-medium leading-relaxed">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))}

        <div class="bg-gradient-to-br from-blue-600/20 to-transparent border border-blue-500/20 rounded-[2rem] p-8 md:p-12 transition-all hover:bg-blue-600/10">
          <div class="flex flex-col md:flex-row gap-8 items-center justify-between">
            <div class="max-w-xl text-center md:text-left">
              <h2 class="text-2xl font-black italic text-white uppercase mb-4 tracking-wider">{t('membership.support_title')}</h2>
              <p class="text-gray-400 font-medium leading-relaxed mb-6">
                {t('membership.support_desc')}
              </p>
            </div>
            <a href={`/${lang}/support`} class="bg-blue-600 hover:bg-blue-500 text-white font-black uppercase text-xs tracking-[0.2em] italic px-8 py-4 rounded-2xl transition-all shadow-lg shadow-blue-600/20 active:scale-95 whitespace-nowrap">
              {t('membership.support_button')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
