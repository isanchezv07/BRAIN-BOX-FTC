---
// @Isanchezv
// src/pages/[locale]/explore.astro
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getFilteredCourses, getCompletedCoursesIds, getAllCategories, getLikedCourseIds } from "@/lib/courses";

const { locale } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { user, profile } = Astro.locals;

const coursesData = await getFilteredCourses(profile?.role || 'student');
const categories = await getAllCategories();

let completedCoursesIds = new Set<string>();
let likedCourseIds = new Set<string>();

if (user) {
  completedCoursesIds = await getCompletedCoursesIds(user.id, coursesData);
  likedCourseIds = await getLikedCourseIds(user.id);
}

const sanitizedCourses = coursesData.map(c => ({
  id: c.id,
  title: c.title || '',
  description: c.description || '',
  level: c.level || 'Beginner',
  category: c.categories?.name || 'Uncategorized',
  categoryId: c.category_id || '',
  lessonsCount: c.lessons?.length || 0,
  isCompleted: completedCoursesIds.has(c.id),
  isLiked: likedCourseIds.has(c.id),
  hasCertificate: c.has_certificate || false,
  team: c.team || ''
}));
---

<Layout title={t('dashboard.courses.title')}>
  
  <main 
    class="max-w-7xl mx-auto p-6 md:p-12 space-y-12 relative z-10" 
    x-data={`{
      search: '',
      selectedCategory: 'all',
      allCourses: [],
      filteredCourses: [],
      lang: '${lang}',
      init() {
        const dataEl = document.getElementById('courses-json');
        if (dataEl) {
          this.allCourses = JSON.parse(dataEl.textContent);
          this.filteredCourses = this.allCourses;
        }
        this.$watch('search', () => this.filter());
        this.$watch('selectedCategory', () => this.filter());
      },
      async toggleLike(course) {
        try {
          const response = await fetch('/api/courses/like', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ courseId: course.id })
          });
          if (response.ok) {
            const data = await response.json();
            course.isLiked = data.liked;
            const c = this.allCourses.find(x => x.id === course.id);
            if (c) c.isLiked = data.liked;
          }
        } catch (error) {
          console.error('Error toggling like:', error);
        }
      },
      filter() {
        this.filteredCourses = this.allCourses.filter(c => {
          const matchCategory = this.selectedCategory === 'all' || c.categoryId === this.selectedCategory;
          const matchSearch = c.title.toLowerCase().includes(this.search.toLowerCase()) || 
                              c.description.toLowerCase().includes(this.search.toLowerCase());
          return matchCategory && matchSearch;
        });
      }
    }`}
  >
    <script type="application/json" id="courses-json" set:html={JSON.stringify(sanitizedCourses)}></script>
    
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_-20%,rgba(37,99,235,0.15),transparent_70%)]"></div>
        <div class="absolute inset-0 opacity-[0.02]" style="background-image: url('https://grainy-gradients.vercel.app/noise.svg');"></div>
    </div>

    <header class="relative p-10 rounded-[3rem] bg-linear-to-br from-blue-600/20 to-transparent border border-white/5 overflow-hidden">
      <div class="relative z-10">
        <h1 class="text-4xl font-black text-white italic uppercase tracking-tighter">
          {t('dashboard.welcome')} <span class="text-blue-500">{profile?.full_name || profile?.username || t('dashboard.defaultUser')}</span>
        </h1>
        <p class="text-gray-400 mt-2 font-medium italic uppercase text-[10px] tracking-widest">
          {profile?.role === 'admin' ? t('dashboard.roles.admin') : t('dashboard.roles.student')}
        </p>
      </div>
    </header>

    <div class="flex flex-col gap-10 bg-white/[0.01] border border-white/5 p-6 md:p-12 rounded-[3.5rem] backdrop-blur-xl shadow-2xl relative overflow-hidden group/hub">
      <div class="absolute inset-0 bg-blue-600/5 opacity-0 group-hover/hub:opacity-100 transition-opacity duration-1000 pointer-events-none"></div>
      
      <div class="flex flex-col lg:flex-row gap-12 items-stretch lg:items-end relative z-10">
        <div class="relative flex-1">
          <div class="flex items-center justify-between mb-4 px-2">
            <label class="text-[10px] font-black text-zinc-500 uppercase tracking-[0.4em] italic flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-blue-500 shadow-[0_0_8px_#3b82f6]"></span>
              Search_Database _
            </label>
            <span class="text-[9px] font-mono text-zinc-700 uppercase" x-text="filteredCourses.length + ' Results_Found'"></span>
          </div>
          
          <div class="relative group">
            <div class="absolute inset-y-0 left-6 flex items-center pointer-events-none text-zinc-600 group-focus-within:text-blue-500 transition-colors duration-500">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <input 
              type="text" 
              x-model="search"
              placeholder={t('explore.searchPlaceholder')}
              class="w-full bg-black/80 border-2 border-white/5 rounded-3xl py-7 pl-16 pr-10 text-xl font-black text-white focus:outline-none focus:border-blue-600/50 focus:ring-[15px] focus:ring-blue-600/5 transition-all placeholder:text-zinc-800 placeholder:italic italic"
            />
          </div>
        </div>

        <div class="lg:w-[500px]">
          <div class="flex items-center mb-4 px-2">
            <label class="text-[10px] font-black text-zinc-500 uppercase tracking-[0.4em] italic flex items-center gap-2">
               <span class="w-2 h-2 rounded-full bg-zinc-700"></span>
               Core_Categories _
            </label>
          </div>
          <div class="flex flex-wrap gap-2.5">
            <button 
              @click="selectedCategory = 'all'"
              :class="selectedCategory === 'all' ? 'bg-white text-black border-white shadow-[0_0_30px_rgba(255,255,255,0.15)] scale-105' : 'bg-white/5 text-zinc-500 border-white/5 hover:border-white/20 hover:text-white'"
              class="px-7 py-4 rounded-2xl border text-[11px] font-black uppercase italic tracking-widest transition-all duration-500 active:scale-95"
            >
              {t('explore.filterAll')}
            </button>
            {categories.map(cat => (
              <button 
                @click={`selectedCategory = '${cat.id}'`}
                :class={`selectedCategory === '${cat.id}' ? 'bg-blue-600 text-black border-blue-600 shadow-[0_0_30px_rgba(37,99,235,0.3)] scale-105' : 'bg-white/5 text-zinc-500 border-white/5 hover:border-white/20 hover:text-white'`}
                class="px-7 py-4 rounded-2xl border text-[11px] font-black uppercase italic tracking-widest transition-all duration-500 active:scale-95"
              >
                {cat.name}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div id="course-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pb-40">
      <template x-for="course in filteredCourses" :key="course.id">
        <article 
          x-transition:enter="transition ease-out duration-700"
          x-transition:enter-start="opacity-0 translate-y-16 scale-95"
          x-transition:enter-end="opacity-100 translate-y-0 scale-100"
          class="group"
        >
          <a 
            :href="'/' + lang + '/courses/' + course.id" 
            class="course-card group relative flex flex-col justify-between p-8 rounded-[2.5rem] bg-[#0a0a0a] border transition-all duration-500 hover:bg-[#0f0f0f] overflow-hidden h-full"
            :class="course.isCompleted ? 'border-green-500/30 shadow-[0_0_30px_rgba(34,197,94,0.05)]' : 'border-white/3 hover:border-blue-500/40'"
          >
            <div 
              class="absolute -top-24 -right-24 w-48 h-48 blur-[60px] transition-all pointer-events-none"
              :class="course.isCompleted ? 'bg-green-600/10' : 'bg-blue-600/5 group-hover:bg-blue-600/15'"
            ></div>
            
            <div>
              <div class="flex justify-between items-start mb-6">
                <div class="flex flex-col gap-2">
                  <span 
                    class="w-fit px-2.5 py-1 rounded-md bg-white/5 text-gray-500 text-[9px] font-black uppercase tracking-widest border border-white/5"
                    x-text="course.level"
                  ></span>
                  <template x-if="course.isCompleted">
                    <span class="flex items-center gap-1.5 text-[9px] font-black uppercase italic text-green-400 bg-green-500/10 border border-green-500/20 px-2.5 py-1 rounded-md">
                      <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span> {t('dashboard.courses.completed')}
                    </span>
                  </template>
                </div>
                <button 
                  type="button" 
                  @click.prevent="toggleLike(course)"
                  class="relative z-20 p-2.5 rounded-xl bg-white/5 border border-white/5 hover:border-pink-500/50 transition-all group/like active:scale-90"
                  :class="course.isLiked ? 'border-pink-500/50' : 'border-white/5'"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="transition-all duration-300" :class="course.isLiked ? 'fill-pink-500 stroke-pink-500 scale-110' : 'fill-transparent stroke-gray-500 group-hover/like:stroke-pink-400'" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.505 4.046 3 5.5L12 21Z"/>
                  </svg>
                </button>
              </div>
              
              <h3 
                class="text-2xl font-black text-white tracking-tight italic leading-none uppercase transition-colors"
                :class="course.isCompleted ? '' : 'group-hover:text-blue-400'"
                x-text="course.title"
              ></h3>
              
              <div class="mt-3 mb-4">
                <template x-if="course.category">
                  <div 
                    class="inline-flex items-center px-3 py-1.5 rounded-xl border italic"
                    :class="course.isCompleted ? 'bg-green-500/5 border-green-500/10' : 'bg-blue-500/10 border-blue-500/20'"
                  >
                    <span 
                      class="text-[10px] font-black uppercase tracking-widest"
                      :class="course.isCompleted ? 'text-green-600' : 'text-blue-400'"
                      x-text="course.category"
                    ></span>
                  </div>
                </template>
              </div>
              <template x-if="course.description">
                <p class="text-gray-500 text-xs italic leading-relaxed mb-6 line-clamp-2 group-hover:text-gray-400 transition-colors" x-text="course.description"></p>
              </template>
            </div>

            <footer 
              class="flex items-center justify-between pt-5 border-t mt-auto"
              :class="course.isCompleted ? 'border-green-500/10' : 'border-white/3'"
            >
              <div class="flex-1">
                <template x-if="course.team">
                  <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-500/10 border border-blue-500/20 rounded-full">
                    <span class="text-[9px] font-black text-blue-500/60 uppercase tracking-widest italic">By:</span>
                    <span class="text-[9px] font-black text-blue-400 uppercase tracking-widest italic" x-text="course.team"></span>
                  </div>
                </template>
              </div>
              
              <div class="flex items-center gap-2">
                <span 
                  class="text-[10px] font-black transition-all duration-300 transform uppercase italic"
                  :class="{
                    'translate-x-0 text-green-500': course.isCompleted,
                    'translate-x-2 group-hover:translate-x-0 text-blue-500 opacity-0 group-hover:opacity-100': !course.isCompleted
                  }"
                  x-text={`course.isCompleted 
                    ? (course.hasCertificate 
                        ? '${t('dashboard.courses.actions.certificate')}' 
                        : '${t('dashboard.courses.actions.completed')}')
                    : '${t('dashboard.courses.actions.access')}'`}
                >
                </span>
                
                <svg 
                  class="w-3 h-3 transition-all duration-300" 
                  :class="course.isCompleted ? 'text-green-500' : 'text-blue-500 opacity-0 group-hover:opacity-100'"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"
                >
                  <path x-show="course.isCompleted && course.hasCertificate" stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  <path x-show="!(course.isCompleted && course.hasCertificate)" stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </div>
            </footer>
          </a>
        </article>
      </template>
    </div>

    <div 
      x-show="filteredCourses.length === 0"
      x-transition:enter="transition ease-out duration-1000"
      class="py-40 flex flex-col items-center text-center space-y-12"
    >
      <div class="relative">
        <div class="absolute inset-0 bg-blue-600/30 blur-[120px] rounded-full animate-pulse"></div>
        <div class="relative inline-flex items-center justify-center w-36 h-32 rounded-[3.5rem] bg-black border border-white/10 shadow-[0_0_80px_rgba(0,0,0,1)]">
          <svg class="text-zinc-800 animate-pulse" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg>
        </div>
      </div>
      <div class="space-y-4">
        <h4 class="text-5xl font-black italic uppercase tracking-tighter text-white">System_Null_Reference</h4>
        <p class="text-zinc-600 font-bold uppercase tracking-[0.6em] text-xs max-w-md mx-auto leading-relaxed">
          {t('explore.empty')}
        </p>
      </div>
      <button @click="search = ''; selectedCategory = 'all'" class="group relative px-12 py-6 bg-white text-black font-black uppercase italic text-xs tracking-[0.4em] overflow-hidden rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-2xl">
        <span class="relative z-10">Reboot_Search_Sequence</span>
        <div class="absolute inset-0 bg-blue-600 translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-out"></div>
      </button>
    </div>

  </main>
</Layout>

<style is:global>
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: #030303; }
  ::-webkit-scrollbar-thumb { background: #111; border: 1px solid #222; }
  ::-webkit-scrollbar-thumb:hover { background: #3b82f6; border-color: #3b82f6; }

  @keyframes scanline {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  .scanline {
    width: 100%;
    height: 100px;
    background: linear-gradient(to bottom, transparent, rgba(59,130,246,0.05), transparent);
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    animation: scanline 8s linear infinite;
  }
</style>
