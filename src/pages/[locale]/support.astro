---
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { supabase } from "@/lib/supabase";

const { locale } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { data: { user } } = await supabase.auth.getUser();

const { data: profile } = await supabase
  .from("profiles")
  .select("full_name")
  .eq("id", user?.id)
  .single();

const subjects = [
  { id: 'reset', label: t('membership.form.subjects.reset') },
  { id: 'payment', label: t('membership.form.subjects.payment') },
  { id: 'other', label: t('membership.form.subjects.other') }
];
---

<Layout title="Soporte Técnico | Brain Box FTC">
  <main class="min-h-screen bg-[#050505] py-24 px-6 relative overflow-hidden">
    <a href={`/${lang}/account/dashboard`} class="ml-100 inline-flex items-center gap-3 text-[10px] font-black text-gray-500 hover:text-white transition-all uppercase tracking-[0.2em] group">
      <div class="flex items-center justify-center w-8 h-8 rounded-full bg-white/5 border border-white/5 group-hover:border-blue-500/50 group-hover:bg-blue-500/10 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </div>
      {t('buttons.back')}
    </a>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-96 bg-blue-500/10 blur-[120px] pointer-events-none"></div>

    <div class="max-w-2xl mx-auto relative z-10">
      <header class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-black italic text-white uppercase leading-tight mb-4">
          CONTACTAR <span class="text-blue-500">SOPORTE</span>
        </h1>
        <p class="text-gray-500 font-bold uppercase tracking-[0.2em] text-xs">
          {t('membership.support_desc')}
        </p>
      </header>

      <div class="bg-white/5 border border-white/10 rounded-[2.5rem] p-8 md:p-12 backdrop-blur-md">
        <form id="support-form" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-[10px] font-black uppercase text-blue-500 tracking-widest ml-2">{t('membership.form.name')}</label>
              <input 
                type="text" 
                name="name" 
                required 
                value={profile?.full_name || ""}
                class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder:text-gray-600 focus:border-blue-500 focus:outline-none transition-all"
              />
            </div>
            <div class="space-y-2">
              <label class="text-[10px] font-black uppercase text-blue-500 tracking-widest ml-2">{t('membership.form.email')}</label>
              <input 
                type="email" 
                name="email" 
                required 
                value={user?.email || ""}
                class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder:text-gray-600 focus:border-blue-500 focus:outline-none transition-all"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-[10px] font-black uppercase text-blue-500 tracking-widest ml-2">{t('membership.form.subject')}</label>
            <select 
              name="subject" 
              required
              class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white focus:border-blue-500 focus:outline-none transition-all appearance-none cursor-pointer"
            >
              {subjects.map(s => (
                <option value={s.id} class="bg-[#0a0a0a]">{s.label}</option>
              ))}
            </select>
          </div>

          <div class="space-y-2">
            <label class="text-[10px] font-black uppercase text-blue-500 tracking-widest ml-2">{t('membership.form.message')}</label>
            <textarea 
              name="message" 
              required 
              rows="5"
              class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white placeholder:text-gray-600 focus:border-blue-500 focus:outline-none transition-all resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full bg-blue-600 hover:bg-blue-500 text-white py-5 rounded-2xl font-black uppercase text-xs tracking-[0.3em] italic shadow-lg shadow-blue-600/20 transition-all active:scale-95 flex items-center justify-center gap-3"
          >
            <span id="btn-text">{t('membership.form.send')}</span>
            <div id="loader" class="hidden w-4 h-4 border-2 border-white/20 border-t-white rounded-full animate-spin"></div>
          </button>
        </form>

        <div id="status-msg" class="hidden mt-6 p-4 rounded-xl text-center font-bold uppercase text-[10px] tracking-widest">
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  const form = document.getElementById('support-form');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const loader = document.getElementById('loader');
  const statusMsg = document.getElementById('status-msg');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    submitBtn.disabled = true;
    btnText.innerText = 'ENVIANDO...';
    loader.classList.remove('hidden');
    statusMsg.classList.add('hidden');

    const formData = new FormData(form);

    try {
      const response = await fetch('/api/support', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (response.ok) {
        statusMsg.innerText = 'REPORTE ENVIADO CON ÉXITO. REVISAREMOS TU CASO PRONTO.';
        statusMsg.classList.remove('hidden', 'bg-red-500/10', 'text-red-500');
        statusMsg.classList.add('bg-green-500/10', 'text-green-500');
        form.reset();
      } else {
        throw new Error(result.error || 'Error');
      }
    } catch (error) {
      statusMsg.innerText = 'ERROR AL ENVIAR EL REPORTE. INTENTA DE NUEVO.';
      statusMsg.classList.remove('hidden', 'bg-green-500/10', 'text-green-500');
      statusMsg.classList.add('bg-red-500/10', 'text-red-500');
    } finally {
      submitBtn.disabled = false;
      btnText.innerText = 'ENVIAR REPORTE';
      loader.classList.add('hidden');
    }
  });
</script>
