---
// @Isanchezv
// src/components/admin/SubscriptionManager.astro
import { supabaseAdmin } from "@/lib/supabaseAdmin";

// Obtener todos los perfiles que tengan un plan distinto a "free" o que tengan créditos
const { data: subscribers, error } = await supabaseAdmin
  .from("profiles")
  .select("id, full_name, username, email, subscription_plan, ai_credits, last_credit_reset, stripe_customer_id")
  .order("subscription_plan", { ascending: false });

const planNames: Record<string, string> = {
  "free": "Gratis",
  "prod_UIkBvj0Xy5XV5V": "Rookie",
  "prod_UIkCACSFAOw86l": "Pro",
  "prod_UIkDq4szJTfqv8": "Elite"
};

const planColors: Record<string, string> = {
  "free": "text-gray-500 bg-gray-500/10 border-gray-500/20",
  "prod_UIkBvj0Xy5XV5V": "text-blue-400 bg-blue-500/10 border-blue-500/20",
  "prod_UIkCACSFAOw86l": "text-purple-400 bg-purple-500/10 border-purple-500/20",
  "prod_UIkDq4szJTfqv8": "text-amber-400 bg-amber-500/10 border-amber-500/20"
};
---

<div class="space-y-8 animate-in fade-in duration-700">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-3xl font-black text-white italic uppercase tracking-tighter">Gestión de <span class="text-blue-600">Suscripciones</span></h2>
            <p class="text-zinc-500 text-xs font-bold uppercase tracking-widest mt-2">Monitoreo de ingresos y planes de usuario</p>
        </div>
        <div class="flex gap-2">
            <div class="px-4 py-2 bg-white/5 border border-white/10 rounded-xl flex flex-col items-center">
                <span class="text-[10px] font-black text-zinc-500 uppercase tracking-widest">Total Subs</span>
                <span class="text-xl font-black text-white italic">{subscribers?.filter(s => s.subscription_plan !== 'free').length || 0}</span>
            </div>
            <div class="px-4 py-2 bg-blue-600/10 border border-blue-500/20 rounded-xl flex flex-col items-center">
                <span class="text-[10px] font-black text-blue-500 uppercase tracking-widest">Activos</span>
                <span class="text-xl font-black text-white italic">{subscribers?.length || 0}</span>
            </div>
        </div>
    </div>

    <div class="bg-[#0a0a0a] border border-white/5 rounded-[2.5rem] overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-white/5 bg-white/2">
                        <th class="px-6 py-5 text-[10px] font-black text-zinc-500 uppercase tracking-[0.2em]">Usuario</th>
                        <th class="px-6 py-5 text-[10px] font-black text-zinc-500 uppercase tracking-[0.2em]">Plan Actual</th>
                        <th class="px-6 py-5 text-[10px] font-black text-zinc-500 uppercase tracking-[0.2em]">Créditos IA</th>
                        <th class="px-6 py-5 text-[10px] font-black text-zinc-500 uppercase tracking-[0.2em]">Último Reset</th>
                        <th class="px-6 py-5 text-[10px] font-black text-zinc-500 uppercase tracking-[0.2em]">ID Cliente</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {subscribers?.map((user) => (
                        <tr class="group hover:bg-white/2 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span class="text-sm font-black text-white uppercase italic tracking-tighter">{user.full_name || user.username}</span>
                                    <span class="text-[10px] text-zinc-500 font-mono">{user.email}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class={`px-3 py-1 rounded-lg text-[9px] font-black uppercase tracking-tighter border ${planColors[user.subscription_plan] || planColors['free']}`}>
                                    {planNames[user.subscription_plan] || "Desconocido"}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 rounded-full bg-blue-500 shadow-[0_0_8px_#3b82f6]"></div>
                                    <span class="text-sm font-black text-zinc-300 italic">{user.ai_credits || 0}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">
                                    {user.last_credit_reset ? new Date(user.last_credit_reset).toLocaleDateString() : '---'}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <code class="text-[9px] bg-white/5 px-2 py-1 rounded text-zinc-400 border border-white/5">
                                    {user.stripe_customer_id || 'Sin ID'}
                                </code>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</div>
